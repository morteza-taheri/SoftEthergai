<?xml version="1.0" encoding="utf-8"?>
<!--
  BLOCK v1.0.79 — the notification / Quick-Settings glyph.

  Replaces a 72x72 COLORED bitmap of the previous brand (a teal shield with a
  white star and a padlock). Two problems with that asset:

    * Android tints a notification small icon to a single colour, so a coloured
      raster is rendered as a washed-out blob instead of a crisp mark.
    * It was a single 72 px file in a densityless folder, so every density
      upscaled or downscaled it.

  A vector is the right form: one 24 dp glyph, tinted by the system, sharp at
  every density. The shape follows the current app icon — a shield with a
  keyhole cut out — so the notification, the Quick Settings tile and the
  launcher icon read as the same product.

  The keyhole circle is drawn with four cubic Bézier segments (k = 0.5523)
  rather than `a` arc commands: identical geometry, and no dependence on arc
  flag parsing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      One path, three subpaths, evenOdd: the shield is filled and the keyhole
      (circle + stem) is punched out of it. Notification icons must be a solid
      alpha silhouette, which is exactly what this produces.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1.9 L4.2,5.1 L4.2,11.1 C4.2,16.3 7.5,20.7 12,22.2 C16.5,20.7 19.8,16.3 19.8,11.1 L19.8,5.1 Z M14.1,8.4 C14.1,9.5598 12.9402,10.5 12,10.5 C11.0598,10.5 9.9,9.5598 9.9,8.4 C9.9,7.2402 11.0598,6.3 12,6.3 C12.9402,6.3 14.1,7.2402 14.1,8.4 Z M11.3,10.5 L12.7,10.5 L12.7,14.6 L11.3,14.6 Z" />
</vector>
