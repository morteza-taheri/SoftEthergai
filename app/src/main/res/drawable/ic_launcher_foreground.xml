        android:pathData="M49,50 C49,47.2 51.2,45 54,45 C56.8,45 59,47.2 59,50 L59,53 L49,53 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#F8FAFC"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Glowing Keyhole Center -->
    <path
        android:pathData="M54,51m-3,0a3,3 0 1,1 6,0a3,3 0 1,1 -6,0
