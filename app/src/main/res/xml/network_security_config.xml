<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (HTTP) is permitted at the PLATFORM level so the collector can
  reach VPN Gate's official mirrors, which are plain HTTP on an IP:port and
  expose no TLS endpoint.

  The actual restriction lives in code, not here: every collector client is
  built through `collectorClientBuilder()`, which installs
  `CleartextMirrorInterceptor`. That interceptor refuses any cleartext request
  whose host is not a known VPN Gate mirror, and refuses `vpngate.net` /
  `tsukuba.ac.jp` over HTTP outright (they are HTTPS-only).

  Why not a static <domain> list here? The mirror addresses rotate — the
  official directory published four different mirrors on 2026-11-24, of which
  only one was in the previous static list — so a static allowlist silently
  blocked the fallbacks exactly when they were needed. See
  CleartextMirrorPolicy.kt for the full rationale.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
